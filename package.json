{
  "name": "vyapartrack",
  "version": "2.7.0",
  "description": "WhatsApp-native order tracker for small shops: turns Hinglish order messages into a live ledger of customers, items, cost, profit, and revenue. Local-first, with an Android app.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:demo": "node scripts/start-demo.js",
    "server": "node src/server.js",
    "demo": "node scripts/seed-demo.js",
    "test": "npm run test:parser && npm run test:smoke",
    "test:parser": "node scripts/test-parser.js",
    "test:smoke": "node scripts/smoke.js"
  },
  "keywords": [
    "whatsapp",
    "business",
    "orders",
    "profit",
    "tracker",
    "india",
    "hinglish"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pino": "^9.0.0",
    "qrcode": "^1.5.4",
    "zapo-js": "^1.11.0"
  },
  "optionalDependencies": {
    "@zapo-js/store-sqlite": "^1.3.0",
    "better-sqlite3": "^13.0.3"
  }
}
