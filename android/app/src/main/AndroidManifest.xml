<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed only for the WhatsApp share Intent (ACTION_SEND) to find WhatsApp. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <!-- Needed for WhatsApp sharing and the optional hosted-server connection. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- On-phone WhatsApp engine: foreground service keeps whatsmeow alive. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- whatsmeow doesn't sync the address book; names come from the phone's contacts. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:label="VyaparTrack"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".VyaparService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>