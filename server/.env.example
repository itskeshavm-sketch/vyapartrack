# Server
PORT=3000

# Auth token for the REST API (any random string; share with your phone app)
API_TOKEN=change-me-to-a-long-random-string

# Bot
# OFF by default - automatic replies from an unofficial connection can get the
# number restricted. Set to true only if you accept that risk.
AUTO_REPLY=false
# Group chats are ignored by default.
# ALLOW_GROUP_CHATS=true
