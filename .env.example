# ---- App ----
PORT=3000
# Address the desktop server binds to. 127.0.0.1 = this computer only (safe).
# Set HOST=0.0.0.0 to allow other devices on your network to open it.
HOST=127.0.0.1
# true = dashboard only, never connect to WhatsApp
NO_BOT=false
# WhatsApp bot replies with a short order confirmation.
# OFF by default - automatic replies from an unofficial connection are the
# pattern WhatsApp flags, and a restricted number stops the shop taking orders.
AUTO_REPLY=false
# Group chats are ignored by default. Set to true to record orders sent in groups.
# ALLOW_GROUP_CHATS=true
# Where orders/contacts are stored (defaults to ./data)
# VYAPAR_DATA_DIR=C:\path\to\vyapartrack-data
