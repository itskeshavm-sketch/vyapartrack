# ---- Poolside AI (order extraction) ----
# Get your key from your Poolside account dashboard
POOLSIDE_API_KEY=your_poolside_api_key_here
POOLSIDE_MODEL=poolside/laguna-xs-2.1
# Override only if Poolside docs specify a different endpoint
POOLSIDE_BASE_URL=https://api.poolside.ai/v1

# ---- App ----
PORT=3000
# Bot replies "Order tracked" confirmation in the chat after recording an order
AUTO_REPLY=true
# Use Poolside AI first for messy messages (falls back to built-in regex parser)
USE_AI_PARSER=true
