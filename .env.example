# ---- Poolside AI (optional) ----
# Optional. Without a key (or when the API is unreachable) the built-in
# offline Hinglish parser handles orders. Get a key from your Poolside account.
POOLSIDE_API_KEY=your_poolside_api_key_here
POOLSIDE_MODEL=poolside/laguna-xs-2.1
# Override only if Poolside docs specify a different endpoint
POOLSIDE_BASE_URL=https://inference.poolside.ai/v1

# ---- App ----
PORT=3000
# true = dashboard only, never connect to WhatsApp
NO_BOT=false
# Set false to always use the offline regex parser (no network calls)
USE_AI_PARSER=true
# WhatsApp bot replies with a short order confirmation
AUTO_REPLY=true
# Where orders/contacts are stored (defaults to ./data)
# VYAPAR_DATA_DIR=C:\path\to\vyapartrack-data
